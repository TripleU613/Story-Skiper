{
  "manifest_version": 3,
  "name": "Storyline Skipper",
  "version": "1.1",
  "description": "Skip tracks in Articulate Storyline courses",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.hslcnys.org/*", "*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "toggle-skip": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle auto-skip on/off"
    },
    "skip-once": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Skip current slide once"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["injected.js"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": ["*://*.hslcnys.org/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
